# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=debug

# Runtime role (subject to row-level security) and owner role (migrations only).
DATABASE_URL=postgres://businessos_app:businessos_app@localhost:5432/businessos_dev
MIGRATION_DATABASE_URL=postgres://businessos:businessos@localhost:5432/businessos_dev
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated origins allowed to call the API directly (the web app uses a same-origin rewrite).
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (used in emails and redirects; also read by the worker).
APP_URL=http://localhost:3000
# false | true | hop count | comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For.
TRUST_PROXY=false

# Web
API_INTERNAL_URL=http://localhost:4000
# Set to true only when the web server is behind a load balancer/CDN that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Shared by api (producer) and worker (consumer)
QUEUE_PREFIX=bos
# Public origin of the API (provider webhook URLs). https:// in production.
API_PUBLIC_URL=http://localhost:4000
# Channel credential encryption: id:base64(32 random bytes)[,older keys]. Required in production.
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEYS=
# Development only: test email/WhatsApp/SMS providers and the inbound simulator.
COMMUNICATIONS_FAKE_PROVIDERS=true
# Development only: in-memory external calendar provider.
CALENDAR_FAKE_PROVIDERS=true

# Worker
WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=4001
# log (development) | file (end-to-end tests) | postmark (production, with the two below).
EMAIL_TRANSPORT=log
# POSTMARK_SERVER_TOKEN=
# EMAIL_FROM=BusinessOS <no-reply@example.com>
