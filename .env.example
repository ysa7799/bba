# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=debug

# Runtime role (subject to row-level security) and owner role (migrations only).
DATABASE_URL=postgres://businessos_app:businessos_app@localhost:5432/businessos_dev
MIGRATION_DATABASE_URL=postgres://businessos:businessos@localhost:5432/businessos_dev
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated origins allowed to call the API directly (the web app uses a same-origin rewrite).
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (used in emails and redirects).
APP_URL=http://localhost:3000
TRUST_PROXY=false

# Web
API_INTERNAL_URL=http://localhost:4000

# Worker
WORKER_CONCURRENCY=5
