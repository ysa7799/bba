{
  "name": "businessos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@businessos/api --filter=@businessos/worker --filter=@businessos/web",
    "dev:deps": "docker compose up -d postgres redis",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:setup": "bash scripts/db/setup.sh",
    "db:generate": "pnpm --filter @businessos/database db:generate",
    "db:migrate": "pnpm --filter @businessos/database db:migrate",
    "db:migrate:test": "pnpm --filter @businessos/database db:migrate:test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
