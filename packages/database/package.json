{
  "name": "@businessos/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node ../../scripts/db/generate.mjs",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "db:migrate:test": "tsx --env-file=../../.env.test src/migrate.ts"
  },
  "dependencies": {
    "@businessos/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@businessos/config": "workspace:*",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15"
  }
}
