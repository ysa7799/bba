{
  "name": "@businessos/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup && node ../../scripts/verify-bundle-deps.mjs . dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@businessos/activities": "workspace:*",
    "@businessos/calendar": "workspace:*",
    "@businessos/communications": "workspace:*",
    "@businessos/config": "workspace:*",
    "@businessos/crm": "workspace:*",
    "@businessos/database": "workspace:*",
    "@businessos/events": "workspace:*",
    "@businessos/jobs": "workspace:*",
    "@businessos/payments": "workspace:*",
    "@businessos/shared": "workspace:*",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.13.14",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "@businessos/testing": "workspace:*"
  }
}
